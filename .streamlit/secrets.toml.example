# ============================================================================
# MẪU CẤU HÌNH BÍ MẬT CHO STREAMLIT CLOUD / LOCAL
# Khi chạy trên Streamlit Community Cloud: vào App Settings -> Secrets và dán nội dung này
# (thay giá trị thật từ Supabase Dashboard -> Project Settings -> API).
# TUYỆT ĐỐI KHÔNG commit file .streamlit/secrets.toml chứa key thật lên GitHub!
# ============================================================================

[supabase]
url = "https://YOUR_PROJECT_ID.supabase.co"
key = "YOUR_ANON_PUBLIC_KEY"

[auth]
# Tùy chọn: Đặt mật khẩu truy cập chung cho nhóm thẩm định đa quốc gia.
# Bỏ trống hoặc xóa mục [auth] nếu không muốn hiện màn hình nhập Passcode.
team_passcode = "YOUR_TEAM_PASSCODE"
